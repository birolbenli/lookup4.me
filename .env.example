BUYMEACOFFEE_URL=https://buymeacoffee.com/birolbenli
PORT=8080
MAILTEST_DOMAIN=tools.birolbenli.com
# Waiting inbox accept window / how long scored reports stay available
MAILTEST_INBOX_HOURS=24
MAILTEST_REPORT_DAYS=7
FEEDBACK_TO=birolbenli@gmail.com
FEEDBACK_FROM=noreply@tools.birolbenli.com
FEEDBACK_HELO=tools.birolbenli.com
# Daily per-IP limits (UTC day)
RATE_LIMIT_MAILTEST=5
RATE_LIMIT_TOOLS=10
# Admin panel (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# SECRET_KEY=long-random-string
# Redirect HTTP → HTTPS (set 0 only for local docker without TLS)
FORCE_HTTPS=1
# Optional SMTP relay (otherwise delivers directly to recipient MX on port 25)
# FEEDBACK_SMTP_HOST=smtp.example.com
# FEEDBACK_SMTP_PORT=587
# FEEDBACK_SMTP_USER=
# FEEDBACK_SMTP_PASSWORD=
# FEEDBACK_SMTP_TLS=1
